# The configuration must never be served, even if PHP handling breaks
<Files "config.php">
    Require all denied
</Files>
<Files "config.example.php">
    Require all denied
</Files>

# Reject oversized request bodies while the web server/PHP SAPI reads them.
# The application then enforces the exact decimal 95 MB per-file limit and
# returns a JSON error. Keep equivalent limits in nginx/PHP-FPM deployments.
LimitRequestBody 191000000

<IfModule mod_php.c>
    php_value upload_max_filesize 95000000
    php_value post_max_size 191000000
    php_value max_input_time 300
    php_value max_execution_time 900
</IfModule>
